# the scraper and the model files are cloned at build time, not vendored
statcast_scraper/
/swing_profiles/
player_cards/
__pycache__/
*.pyc
# local scratch from running the tools by hand
tools/scorecard/feed_*.json
tools/scorecard/pitches_*.parquet
tools/scorecard/scorecard_*.json
# the cached data files behind the pitcher cards, and a local build of the cards
# (they live in the bucket)
tools/pitcher_card/cache/
pitcher-cards/cards/
# the live worker's local toolchain and dev-server state
tools/live/node_modules/
tools/live/.wrangler/
# a local build of the batted-ball data (it lives in the bucket)
batted-balls/data/
# the homepage tiles' full-size app exports (make_tiles.py crops them into images/)
tools/homepage/cache/
# a local build of the release-angle data (it lives in the bucket)
release-angles/data/

# a local copy of the SHAP tables (they live in the bucket)
model-drilldown/data/
# the Model Drilldown's lint and format toolchain
model-drilldown/node_modules
tools/park_factors/cache/
# the Savant pulls behind the xwOBA model
tools/xwoba/cache/
# the Lineup Sim pipeline's FanGraphs extract and per-game play-by-play
tools/lineup_sims/cache/

# NBA Shot Charts: the downloaded xFG grid and the built JSON
tools/nba_shot_charts/cache/
# wrangler's local cache, from running the NBA build (or any wrangler command) at the repo root
.wrangler/
