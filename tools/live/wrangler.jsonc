// Live game poller. Deployed by .github/workflows/live-worker.yml; see README.md.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "blandalytics-live",
  "main": "src/index.js",
  "compatibility_date": "2026-09-01",

  // Every minute, all day: the leagues on the schedule start from about 10:00 UTC
  // (a Tokyo or Seoul series) through 15:00 UTC (11:05am ET matinees, minor-league
  // school-day games), and a long West Coast game can end after 07:00 UTC. Each tick
  // polls twice, 30s apart, and exits after one poll when nothing is live.
  "triggers": { "crons": ["* * * * *"] },

  "r2_buckets": [{ "binding": "BUCKET", "bucket_name": "blandalytics-live" }],

  "observability": { "enabled": true }
}
